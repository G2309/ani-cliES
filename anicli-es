#!/usr/bin/env python3
"""
anicli-es - Cliente para ver anime desde terminal o rofi

Uso:
    anicli-es                    # Modo interactivo (detecta automaticamente)
    anicli-es --rofi             # Forzar modo rofi
    anicli-es --term             # Forzar modo terminal
    anicli-es "nombre anime"     # Buscar directamente
    anicli-es --rofi "nombre"    # Buscar en modo rofi
"""

import sys
import os
import re
import subprocess
import urllib.request
import urllib.parse
import ssl
import argparse
import tempfile
import hashlib
import shutil
import json
import base64
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor
from bs4 import BeautifulSoup

ssl._create_default_https_context = ssl._create_unverified_context

BASE_URL = "https://jkanime.net"
HEADERS = {
    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"
}
CACHE_DIR = Path(tempfile.gettempdir()) / "anicli-es"

C_RED = "\033[91m"
C_GREEN = "\033[92m"
C_YELLOW = "\033[93m"
C_BLUE = "\033[94m"
C_RESET = "\033[0m"

def is_rofi_available():
    return shutil.which("rofi") is not None

def is_running_in_terminal():
    return sys.stdin.isatty() and sys.stdout.isatty()

def download_image(url, path):
    try:
        req = urllib.request.Request(url, headers=HEADERS)
        with urllib.request.urlopen(req, timeout=10) as resp:
            with open(path, "wb") as f:
                f.write(resp.read())
        return True
    except:
        return False

def get_cached_image(url):
    if not url:
        return None
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    filename = hashlib.md5(url.encode()).hexdigest() + (Path(urllib.parse.urlparse(url).path).suffix or ".jpg")
    path = CACHE_DIR / filename
    if path.exists():
        return str(path)
    if download_image(url, path):
        return str(path)
    return None

class MenuInterface:
    def select(self, options, prompt="Selecciona:", icons=None):
        raise NotImplementedError
    
    def input_text(self, prompt=""):
        raise NotImplementedError
    
    def notify(self, message, wait=False):
        raise NotImplementedError

class TerminalMenu(MenuInterface):
    def __init__(self):
        from simple_term_menu import TerminalMenu as STM
        self.STM = STM
    
    def select(self, options, prompt="Selecciona:", icons=None):
        menu = self.STM(options, title=prompt)
        return menu.show()
    
    def input_text(self, prompt=""):
        try:
            return input(prompt).strip()
        except (EOFError, KeyboardInterrupt):
            return None
    
    def notify(self, message, wait=False):
        print(message)
        if wait:
            input("\nEnter para continuar...")

class RofiMenu(MenuInterface):
    def __init__(self, theme=None):
        self.theme = theme
    
    def _rofi_cmd(self, prompt, extra_args=None):
        cmd = ["rofi", "-dmenu", "-i", "-p", prompt]
        if self.theme:
            cmd.extend(["-theme", self.theme])
        if extra_args:
            cmd.extend(extra_args)
        return cmd
    
    def select(self, options, prompt="Selecciona:", icons=None):
        if not options:
            return None
        
        extra_args = ["-format", "i"]
        if icons:
            extra_args.append("-show-icons")
        
        cmd = self._rofi_cmd(prompt, extra_args)
        
        if icons and len(icons) == len(options):
            input_text = "\n".join(
                f"{opt}\0icon\x1f{icons[i]}" if icons[i] else opt
                for i, opt in enumerate(options)
            )
        else:
            input_text = "\n".join(options)
        
        try:
            result = subprocess.run(
                cmd,
                input=input_text,
                capture_output=True,
                text=True
            )
            if result.returncode == 0 and result.stdout.strip():
                return int(result.stdout.strip())
            return None
        except:
            return None
    
    def input_text(self, prompt=""):
        cmd = self._rofi_cmd(prompt)
        try:
            # input="" evita que rofi se quede leyendo la terminal si se lanza desde ella
            result = subprocess.run(cmd, input="", capture_output=True, text=True)
            if result.returncode == 0:
                return result.stdout.strip()
            return None
        except:
            return None

    def notify(self, message, wait=False):
        if not wait:
            return  # solo errores/avisos (wait=True); el progreso no notifica
        message = re.sub(r"\033\[\d+m", "", message)  # sin colores ANSI en notificaciones
        try:
            subprocess.run(
                ["notify-send", "-a", "anicli-es", "anicli-es", message],
                capture_output=True
            )
        except:
            subprocess.run(["rofi", "-e", message], capture_output=True)

def fetch(url):
    req = urllib.request.Request(url, headers=HEADERS)
    with urllib.request.urlopen(req, timeout=30) as resp:
        return resp.read().decode("utf-8")

def search(query):
    html = fetch(f"{BASE_URL}/buscar/{urllib.parse.quote(query)}/")
    soup = BeautifulSoup(html, "html.parser")
    results = []
    for item in soup.select(".anime__item"):
        title_el = item.select_one(".anime__item__text h5 a")
        img_el = item.select_one("[data-setbg]")
        if title_el:
            results.append({
                "title": title_el.get_text(strip=True),
                "url": title_el["href"],
                "img": img_el.get("data-setbg", "") if img_el else ""
            })
    return results

def get_episodes(anime_url):
    html = fetch(anime_url)
    # En emision: enlace "Ultimo episodio" (#uep). Concluido: "Episodios: N".
    m = re.search(r'href="[^"]*/(\d+)/"\s+id="uep"', html) or \
        re.search(r'<span>Episodios:</span>\s*(\d+)', html)
    total = int(m.group(1)) if m else 0
    # shortcut: asume episodios numerados 1..N; usar /ajax/episodes si aparece un anime que empiece en 0
    return [{"num": n, "url": f"{anime_url.rstrip('/')}/{n}/"} for n in range(1, total + 1)]

def get_servers(episode_url):
    html = fetch(episode_url)
    soup = BeautifulSoup(html, "html.parser")
    servers = []
    # Reproductores propios de jkanime (Desu, Magi): entregan m3u8/mp4 directo.
    iframes = dict(re.findall(r"video\[(\d+)\] = '<iframe[^>]*src=\"([^\"]+)\"", html))
    for a in soup.select("a.servers.btn-show"):
        src = iframes.get(a.get("data-id", ""))
        if src:
            name = a.get_text(strip=True)
            n = sum(s["name"].split(" ")[0] == name for s in servers)
            servers.append({"name": f"{name} {n + 1}" if n else name, "url": src})
    # Servidores externos: embed en base64 dentro de "var servers".
    m = re.search(r"var servers = (\[.*?\]);", html)
    for sv in json.loads(m.group(1)) if m else []:
        try:
            url = base64.b64decode(sv["remote"]).decode().strip()
        except Exception:
            continue
        servers.append({"name": sv["server"], "url": url})
    return servers

def get_video_url(server):
    url = server["url"]
    if "/jkplayer/" not in url:
        return url  # embed externo: mpv lo resuelve con yt-dlp
    m = re.search(r"(?:url:|source src=)\s*'(https?://[^']+)'", fetch(url))
    return m.group(1) if m else None

def play_video(url, title=""):
    # --no-terminal: mpv no escribe ni lee teclas en la terminal del menu
    subprocess.Popen(["mpv", "--no-terminal", f"--title={title}", url])

# Orden de preferencia: Desu/Magi son de jkanime y dan m3u8 directo; Mp4upload
# lo resuelve yt-dlp. El resto depende de yt-dlp y suele fallar. Mega, Mediafire
# y 1Fichier son descargas, no streams, asi que se excluyen del menu.
SERVER_PRIORITY = ["Desu", "Magi", "Mp4upload"]
EXCLUDED_SERVERS = {"Mega", "Mediafire", "1Fichier"}

def sort_servers(servers):
    playable = [s for s in servers if s["name"] not in EXCLUDED_SERVERS]

    def priority(s):
        try:
            return SERVER_PRIORITY.index(s["name"])
        except ValueError:
            return len(SERVER_PRIORITY)

    return sorted(playable, key=priority)

class AniCli:
    def __init__(self, menu: MenuInterface, use_icons=False):
        self.menu = menu
        self.use_icons = use_icons
    
    def run(self, initial_query=None):
        while True:
            query = initial_query
            initial_query = None
            
            if not query:
                query = self.menu.input_text("Buscar anime: ")
                if not query:
                    return
            
            self.menu.notify(f"{C_BLUE}Buscando: {query}{C_RESET}")
            
            try:
                results = search(query)
            except Exception as e:
                self.menu.notify(f"{C_RED}Error en busqueda: {e}{C_RESET}", wait=True)
                continue
            
            if not results:
                self.menu.notify(f"{C_YELLOW}No se encontraron resultados{C_RESET}", wait=True)
                continue
            
            icons = None
            if self.use_icons:
                with ThreadPoolExecutor(max_workers=8) as executor:
                    icons = list(executor.map(
                        lambda r: get_cached_image(r["img"]),
                        results
                    ))
                icons.append(None)
            
            options = [r["title"] for r in results]
            options.append("Salir")
            
            idx = self.menu.select(options, "Selecciona anime:", icons=icons)
            if idx is None or idx == len(results):
                continue
            
            selected = results[idx]
            self.browse_episodes(selected)
    
    def browse_episodes(self, anime):
        self.menu.notify(f"{C_BLUE}Cargando episodios de {anime['title']}...{C_RESET}")
        
        try:
            episodes = get_episodes(anime["url"])
        except Exception as e:
            self.menu.notify(f"{C_RED}Error cargando episodios: {e}{C_RESET}", wait=True)
            return
        
        if not episodes:
            self.menu.notify(f"{C_YELLOW}No se encontraron episodios{C_RESET}", wait=True)
            return
        
        anime_icon = None
        if self.use_icons:
            anime_icon = get_cached_image(anime.get("img"))
        
        page_size = 12
        current_page = 0
        total_pages = (len(episodes) + page_size - 1) // page_size
        
        while True:
            start = current_page * page_size
            end = min(start + page_size, len(episodes))
            page_eps = episodes[start:end]
            
            options = [f"Episodio {ep['num']}" for ep in page_eps]
            
            if current_page > 0:
                options.append("<< Anterior")
            if current_page < total_pages - 1:
                options.append(">> Siguiente")
            options.append(">> Volver")
            
            icons = None
            if self.use_icons and anime_icon:
                icons = [anime_icon] * len(page_eps)
                icons += [None] * (len(options) - len(page_eps))
            
            title_menu = f"{anime['title']} [{current_page + 1}/{total_pages}]"
            idx = self.menu.select(options, title_menu, icons=icons)
            
            if idx is None:
                break
            
            choice = options[idx]
            
            if choice == ">> Volver":
                break
            elif choice == "<< Anterior":
                current_page -= 1
            elif choice == ">> Siguiente":
                current_page += 1
            else:
                ep = page_eps[idx]
                self.play_episode(anime, ep)
    
    def play_episode(self, anime, episode):
        self.menu.notify(f"{C_BLUE}Cargando servidores...{C_RESET}")

        try:
            servers = sort_servers(get_servers(episode["url"]))
        except Exception as e:
            self.menu.notify(f"{C_RED}Error: {e}{C_RESET}", wait=True)
            return

        if not servers:
            self.menu.notify(f"{C_YELLOW}No se encontraron servidores reproducibles{C_RESET}", wait=True)
            return

        while True:
            options = [s["name"] for s in servers]
            options.append(">> Volver")

            idx = self.menu.select(options, f"Servidor para {anime['title']} - Ep {episode['num']}:")
            if idx is None or idx == len(servers):
                return

            server = servers[idx]
            self.menu.notify(f"{C_BLUE}Obteniendo URL de {server['name']}...{C_RESET}")

            try:
                video_url = get_video_url(server)
                if video_url:
                    self.menu.notify(f"{C_GREEN}Reproduciendo...{C_RESET}")
                    play_video(video_url, f"{anime['title']} - Ep {episode['num']}")
                    return
                else:
                    self.menu.notify(f"{C_RED}No se pudo obtener la URL de {server['name']}, prueba otro servidor{C_RESET}", wait=True)
            except Exception as e:
                self.menu.notify(f"{C_RED}Error con {server['name']}: {e}, prueba otro servidor{C_RESET}", wait=True)

def main():
    parser = argparse.ArgumentParser(description="anicli-es - Ver anime desde terminal o rofi")
    parser.add_argument("query", nargs="?", help="Busqueda inicial")
    parser.add_argument("--rofi", action="store_true", help="Forzar modo rofi")
    parser.add_argument("--term", action="store_true", help="Forzar modo terminal")
    parser.add_argument("--theme", help="Tema de rofi a usar")
    
    args = parser.parse_args()
    
    use_rofi = False
    
    if args.rofi:
        use_rofi = True
    elif args.term:
        use_rofi = False
    elif not is_running_in_terminal() and is_rofi_available():
        use_rofi = True
    
    if use_rofi:
        if not is_rofi_available():
            print(f"{C_RED}Error: rofi no esta instalado{C_RESET}", file=sys.stderr)
            sys.exit(1)
        menu = RofiMenu(theme=args.theme)
    else:
        try:
            menu = TerminalMenu()
        except ImportError:
            print(f"{C_RED}Error: simple_term_menu no esta instalado{C_RESET}", file=sys.stderr)
            print("Instalar con: pip install simple-term-menu", file=sys.stderr)
            sys.exit(1)
    
    app = AniCli(menu, use_icons=use_rofi)
    try:
        app.run(initial_query=args.query)
    except KeyboardInterrupt:
        pass

main()
